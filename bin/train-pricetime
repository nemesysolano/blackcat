#!/usr/bin/env bash
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
QUOTES_FILE=$1
MODELS_DIR="${SCRIPT_DIR}/../models"
QUOTES=$(cat $QUOTES_FILE)
MODEL="price-time-wavelet-direction"
for QUOTE in $QUOTES; do
    QUOTE_MODEL_FILE="${MODELS_DIR}/${QUOTE}-${MODEL}.keras"
    if [ ! -f "${QUOTE_MODEL_FILE}" ]; then
        python3 ${SCRIPT_DIR}/train_pricetime.py $QUOTE
        STATUS=$?
        if [ ${STATUS} -ne 0 ]; then
            exit -1
        fi

    else
        echo "/${QUOTE}-${MODEL}.keras already exists"
    fi
    
done
